# Postgres is optional. Without DATABASE_URL the app uses the seeded in-memory repository.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/voice_agent_lab
DATABASE_URL_UNPOOLED=
EXTRACTION_MODE=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Shared secret Bland sends in the x-bland-webhook-secret header. Required in production.
BLAND_WEBHOOK_SECRET=
# Shared secret for operator/demo routes, sent in the x-operator-secret header.
# Unset: routes are open in local development and closed (403) in production.
OPERATOR_API_SECRET=
# Wipes every table in DATABASE_URL (db:seed, verify:db, evals against Postgres). Disposable databases only.
# ALLOW_DESTRUCTIVE_DB_RESET=1
NEXT_PUBLIC_APP_URL=http://localhost:3000
